PORT=3001
CORS_ORIGIN=http://localhost:5173
ROTEIRIZADOR_TIMEZONE_OFFSET=-03:00

# HERE - nunca hardcodar no codigo
HERE_API_KEY=

# Persistencia do Control Tower
# Railway/HML/Producao: use CT_STORE_DRIVER=postgres + DATABASE_URL privado interno.
# Desenvolvimento local: use CT_STORE_DRIVER=mssql e uma base separada ControlTowerDev.
CT_STORE_DRIVER=auto

# PostgreSQL Control Tower - Railway
DATABASE_URL=
PG_SSL=false

# SQL Server local do Control Tower
# Se server/usuario/senha ficarem vazios, o modo mssql reutiliza os dados DEAK_DB_*.
CT_SQL_DB_SERVER=
CT_SQL_DB_PORT=1433
CT_SQL_DB_DATABASE=ControlTowerDev
CT_SQL_DB_USER=
CT_SQL_DB_PASSWORD=
CT_SQL_DB_ENCRYPT=false
CT_SQL_DB_TRUST_CERT=true
CT_SQL_DB_REQUEST_TIMEOUT=30000

# Deak SQL Server - usuario somente leitura
DEAK_DB_SERVER=
DEAK_DB_PORT=1433
DEAK_DB_DATABASE=Deak
DEAK_DB_USER=
DEAK_DB_PASSWORD=
DEAK_DB_ENCRYPT=false
DEAK_DB_TRUST_CERT=true
DEAK_DB_REQUEST_TIMEOUT=30000

# Contele Fleet
CONTELE_API_KEY=
CONTELE_TIMEOUT_MS=20000
