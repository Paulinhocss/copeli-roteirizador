# Copeli Roteirizador v2
# Copie para .env somente no ambiente local. Nunca versione valores reais.

PORT=3000
CORS_ORIGIN=*

# HERE
HERE_API_KEY=
ROTEIRIZADOR_TIMEZONE_OFFSET=-03:00

# PostgreSQL proprio do roteirizador
DATABASE_URL=
PG_SSL=false

# Deak - usar login exclusivo e somente leitura
DEAK_DB_SERVER=
DEAK_DB_PORT=1433
DEAK_DB_DATABASE=Deak
DEAK_DB_USER=
DEAK_DB_PASSWORD=
DEAK_DB_ENCRYPT=false
DEAK_DB_TRUST_CERT=true
DEAK_DB_REQUEST_TIMEOUT=30000
