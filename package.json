{
  "name": "copeli-control-tower",
  "version": "3.0.0",
  "private": true,
  "description": "Control Tower logistica da Copeli",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace @copeli/control-tower-api run dev",
    "dev:web": "npm --workspace @copeli/control-tower-web run dev",
    "build": "npm run verify:secrets && npm --workspace @copeli/control-tower-web run build && npm --workspace @copeli/control-tower-api run build",
    "check": "npm run verify:secrets && npm --workspace @copeli/control-tower-web run check && npm --workspace @copeli/control-tower-api run check && npm test",
    "test": "node --test tests/*.test.js",
    "verify:secrets": "node scripts/verificar-segredos.cjs",
    "prestart": "npm run build",
    "start": "npm --workspace @copeli/control-tower-api run start"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
